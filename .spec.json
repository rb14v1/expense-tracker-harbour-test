{
  "appName": "Expense Tracker",
  "domainModel": {
    "entities": [
      {
        "name": "Expense",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "amount",
            "type": "number",
            "required": true
          },
          {
            "name": "category",
            "type": "enum",
            "required": true
          },
          {
            "name": "date",
            "type": "date",
            "required": true
          },
          {
            "name": "note",
            "type": "string",
            "required": false
          },
          {
            "name": "reimbursed",
            "type": "boolean",
            "required": true
          },
          {
            "name": "submittedBy",
            "type": "string",
            "required": true
          }
        ]
      },
      {
        "name": "Category",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "color",
            "type": "string",
            "required": false
          },
          {
            "name": "budget",
            "type": "number",
            "required": false
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "name": "Dashboard",
      "route": "/",
      "purpose": "Overview of total spend per category and reimbursement status",
      "components": [
        "CategoryTotalsChart",
        "RecentExpensesList",
        "SummaryCards"
      ],
      "requiresAuth": false,
      "primaryEntity": "Expense",
      "dataNeeds": [
        "Expense",
        "Category"
      ]
    },
    {
      "name": "ExpensesList",
      "route": "/expenses",
      "purpose": "List all expenses with filter by category and search by title",
      "components": [
        "SearchBar",
        "CategoryFilter",
        "ExpenseTable"
      ],
      "requiresAuth": false,
      "primaryEntity": "Expense",
      "dataNeeds": [
        "Expense",
        "Category"
      ]
    },
    {
      "name": "NewExpense",
      "route": "/expenses/new",
      "purpose": "Create a new expense entry",
      "components": [
        "ExpenseForm"
      ],
      "requiresAuth": false,
      "primaryEntity": "Expense",
      "dataNeeds": [
        "Category"
      ],
      "formFields": [
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "number"
        },
        {
          "name": "category",
          "type": "enum",
          "options": [
            "Travel",
            "Meals",
            "Software",
            "Office Supplies",
            "Training",
            "Other"
          ]
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "note",
          "type": "string"
        },
        {
          "name": "reimbursed",
          "type": "boolean"
        },
        {
          "name": "submittedBy",
          "type": "string"
        }
      ]
    },
    {
      "name": "ExpenseDetail",
      "route": "/expenses/:id",
      "purpose": "View details of a single expense and toggle reimbursed status",
      "components": [
        "ExpenseDetailCard",
        "ReimburseToggle"
      ],
      "requiresAuth": false,
      "primaryEntity": "Expense",
      "dataNeeds": [
        "Expense"
      ]
    },
    {
      "name": "EditExpense",
      "route": "/expenses/:id/edit",
      "purpose": "Edit an existing expense",
      "components": [
        "ExpenseForm"
      ],
      "requiresAuth": false,
      "primaryEntity": "Expense",
      "dataNeeds": [
        "Expense",
        "Category"
      ],
      "formFields": [
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "number"
        },
        {
          "name": "category",
          "type": "enum",
          "options": [
            "Travel",
            "Meals",
            "Software",
            "Office Supplies",
            "Training",
            "Other"
          ]
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "note",
          "type": "string"
        },
        {
          "name": "reimbursed",
          "type": "boolean"
        },
        {
          "name": "submittedBy",
          "type": "string"
        }
      ]
    },
    {
      "name": "Categories",
      "route": "/categories",
      "purpose": "Manage expense categories",
      "components": [
        "CategoryList",
        "CategoryForm"
      ],
      "requiresAuth": false,
      "primaryEntity": "Category",
      "dataNeeds": [
        "Category"
      ],
      "formFields": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "color",
          "type": "string"
        },
        {
          "name": "budget",
          "type": "number"
        }
      ]
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "expenses",
      "purpose": "Load all expenses from localStorage",
      "requiresAuth": false
    },
    {
      "method": "POST",
      "path": "expenses",
      "purpose": "Create a new expense",
      "requiresAuth": false
    },
    {
      "method": "PUT",
      "path": "expenses",
      "purpose": "Update an expense",
      "requiresAuth": false
    },
    {
      "method": "DELETE",
      "path": "expenses",
      "purpose": "Delete an expense",
      "requiresAuth": false
    },
    {
      "method": "GET",
      "path": "categories",
      "purpose": "Load all categories",
      "requiresAuth": false
    },
    {
      "method": "POST",
      "path": "categories",
      "purpose": "Create a new category",
      "requiresAuth": false
    },
    {
      "method": "PUT",
      "path": "categories",
      "purpose": "Update a category",
      "requiresAuth": false
    },
    {
      "method": "DELETE",
      "path": "categories",
      "purpose": "Delete a category",
      "requiresAuth": false
    }
  ],
  "workflows": [
    {
      "name": "Log Expense",
      "steps": [
        {
          "step": 1,
          "actor": "Team Member",
          "action": "Open new expense form",
          "nextStatus": "drafting"
        },
        {
          "step": 2,
          "actor": "Team Member",
          "action": "Fill title, amount, category, date, note",
          "nextStatus": "pending"
        },
        {
          "step": 3,
          "actor": "Team Member",
          "action": "Save expense",
          "nextStatus": "logged"
        }
      ]
    },
    {
      "name": "Reimburse Expense",
      "steps": [
        {
          "step": 1,
          "actor": "Manager",
          "action": "Open expense detail",
          "nextStatus": "reviewing"
        },
        {
          "step": 2,
          "actor": "Manager",
          "action": "Toggle reimbursed to true",
          "nextStatus": "reimbursed"
        }
      ]
    }
  ],
  "styling": {
    "framework": "Tailwind",
    "components": "React",
    "theme": "Version1",
    "colors": {
      "primary": "#00c6c2",
      "dark": "#052831",
      "cream": "#fdf7ea"
    }
  },
  "dependencies": [
    "react",
    "react-router-dom",
    "tailwindcss",
    "lucide-react"
  ],
  "riskFactors": [
    "localStorage size limits with many expenses",
    "No real authentication for internal use",
    "Data loss if browser storage cleared"
  ],
