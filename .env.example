# ---------------------------------------------------------------------------
# Expense-test2 – environment variable reference
# Copy this file to .env and fill in values for local development.
# Never commit .env to source control.
#
# Validation runs at startup (vite.config.ts → validateEnv / src/env.ts).
# The app will refuse to start if any variable marked REQUIRED is absent or
# if any variable is set to an invalid value.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Server / network
# ---------------------------------------------------------------------------

# TCP port the Vite dev server (npm run dev) and preview server (npm start)
# listen on.  Must be an integer in the range 1–65535.
# Optional – defaults to 5173 when not set.
PORT=

# ---------------------------------------------------------------------------
# Application – VITE_ prefix makes these available in browser bundles
# ---------------------------------------------------------------------------

# Human-readable title shown in the application header.
# Optional – defaults to "Expense Tracker" when not set.
VITE_APP_TITLE=
